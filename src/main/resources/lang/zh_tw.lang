# Xinbot 遙測伺服端語言檔:繁體中文
# 格式與 Xinbot 核心 .lang 一致:key=value、# 註解、UTF-8 編碼。

bot.unknown_server=(未連線)
bot.unknown_name=(未知)

# ---- 設定 ----
config.bad_arg=無法辨識的參數(僅支援 --help 與 --config=路徑): %s
config.generated=找不到設定檔,已產生預設設定檔 %s,修改後請重新啟動生效
config.load_failed=設定載入失敗: %s
config.db_type_invalid=db.type 僅支援 sqlite 或 mysql,目前: %s
config.lang_invalid=lang 僅支援 zh_cn、zh_tw 或 en_us,目前: %s
config.port_negative=udp.port / http.port 不能為負數(0 表示停用)
config.bad_number=%s 不是合法整數: %s

usage.main=用法: java -jar XinBotTelemetry.jar [--config=設定檔路徑]
usage.opt=--config=路徑   指定設定檔(預設 ./config.yml,首次啟動自動產生)
usage.note=所有設定項均透過設定檔設定(UTF-8 YAML,支援 # 註解),修改後重新啟動生效:
usage.items_db=lang=zh_cn|zh_tw|en_us(語言) | db.type=sqlite|mysql(儲存類型) | db.file=telemetry.db | db.url、db.user、db.password(MySQL)
usage.items_net=udp.port=9000(UDP 埠,0 停用) | http.port=8080(HTTP 埠,0 停用) | online.timeout=600000(心跳逾時毫秒)
usage.client=客戶端 config.conf 對應設定:telemetry.ip 填本伺服端 IP;mode="udp" 時 port 用 udp.port,mode="http" 時 port 用 http.port

# ---- 啟動與停止 ----
main.key.from_config=使用 config.yml 中的 key 作為遙測加密金鑰
main.key.config_invalid=config.yml 中的 key 無效(應為 Base64 編碼的 32 位元組): %s
main.key.file_loaded=已從 %s 載入遙測加密金鑰
main.key.file_generated=未設定 key,已產生新的遙測金鑰並儲存到 %s(內容: %s)。用戶端 config.conf 的 telemetry.key 可填入該值,也可留空自動取得(明文交換,僅建議可信網路);請妥善保存本檔案
main.key.file_invalid=遙測金鑰檔 %s 內容無效(應為 Base64 編碼的 32 位元組): %s
main.key.file_failed=讀取或寫入遙測金鑰檔 %s 失敗: %s
main.store_ready=儲存類型: %s,線上逾時: %s 秒,啟動參數: %s
main.ready=XinBot 遙測伺服端已就緒,按 Ctrl+C 停止
main.stopping=正在停止遙測伺服端...
main.store_init_failed=資料庫初始化失敗,請檢查儲存設定: %s
main.no_listener=UDP 與 HTTP 埠皆為 0,沒有任何監聽入口,退出

# ---- UDP / HTTP ----
udp.started=UDP 遙測服務已啟動,監聽 0.0.0.0:%s(所有網卡)
udp.socket_error=UDP 通訊端異常
udp.recv_error=UDP 接收處理異常
http.started=HTTP 服務已啟動,監聽 0.0.0.0:%s(所有網卡),監控頁面: http://<本機IP>:%s/
api.error=API 處理失敗

# ---- 遙測處理 ----
handler.drop=捨棄無法解密的遙測資料(來自 %s): %s
handler.crash_saved=已儲存崩潰日誌: %s @%s %s
handler.crash_save_failed=崩潰日誌入庫失敗: %s
handler.key_requested=用戶端 %s 要求取得遙測金鑰(明文交換,建議僅在可信網路啟用)

# ---- 協定解碼 ----
dec.packet_short=資料包過短: %s 位元組
dec.bad_magic=魔數不符,非 Xinbot 遙測資料
dec.bad_version=不支援的協定版本: %s
dec.unknown_type=未知訊息類型: %s
dec.decrypt_failed=解密失敗(金鑰不符或資料遭竄改)
dec.bad_json=遙測負載不是合法的 JSON
dec.type_mismatch=信封訊息類型(%s)與負載 JSON 的 type 欄位(%s)不一致

