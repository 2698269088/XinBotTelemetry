# Xinbot telemetry server language file: en_us (base fallback language)
# Format matches Xinbot core .lang files: key=value, '#' comments, UTF-8.

bot.unknown_server=(not connected)
bot.unknown_name=(unknown)

# ---- config ----
config.bad_arg=Unrecognized argument (only --help and --config=PATH are supported): %s
config.generated=Config file not found, generated default config at %s; restart to apply
config.load_failed=Failed to load config: %s
config.db_type_invalid=db.type must be sqlite or mysql, got: %s
config.lang_invalid=lang must be zh_cn, zh_tw or en_us, got: %s
config.port_negative=udp.port / http.port must not be negative (0 disables)
config.bad_number=%s is not a valid integer: %s

usage.main=Usage: java -jar XinBotTelemetry.jar [--config=config-file-path]
usage.opt=--config=PATH   Use a custom config file (default ./config.yml, auto-generated on first run)
usage.note=All settings live in the config file (UTF-8 YAML, # comments), restart to apply:
usage.items_db=lang=zh_cn|zh_tw|en_us (language) | db.type=sqlite|mysql (storage) | db.file=telemetry.db | db.url, db.user, db.password (MySQL)
usage.items_net=udp.port=9000 (UDP port, 0 disables) | http.port=8080 (HTTP port, 0 disables) | online.timeout=600000 (heartbeat timeout ms)
usage.client=Client config.conf mapping: telemetry.ip = this server IP; port = udp.port when mode="udp", http.port when mode="http"

# ---- startup / shutdown ----
main.key.from_config=Using the key from config.yml as the telemetry encryption key
main.key.config_invalid=The key in config.yml is invalid (expected Base64 of 32 bytes): %s
main.key.file_loaded=Loaded telemetry encryption key from %s
main.key.file_generated=No key configured, generated a new telemetry key saved to %s (value: %s). Clients may set config.conf telemetry.key to this value or leave it empty to fetch it automatically (plaintext exchange, trusted networks only); keep this file safe
main.key.file_invalid=Telemetry key file %s is invalid (expected Base64 of 32 bytes): %s
main.key.file_failed=Failed to read or write telemetry key file %s: %s
main.store_ready=Storage: %s, online timeout: %s s, launch params: %s
main.ready=XinBot telemetry server is ready, press Ctrl+C to stop
main.stopping=Shutting down telemetry server...
main.store_init_failed=Database initialization failed, check storage config: %s
main.no_listener=Both UDP and HTTP ports are 0, no listener, exiting

# ---- udp / http ----
udp.started=UDP telemetry service started, listening on 0.0.0.0:%s (all interfaces)
udp.socket_error=UDP socket error
udp.recv_error=UDP receive error
http.started=HTTP service started, listening on 0.0.0.0:%s (all interfaces), dashboard: http://<host-ip>:%s/
api.error=API handler error

# ---- telemetry pipeline ----
handler.drop=Dropped undecryptable telemetry packet (from %s): %s
handler.crash_saved=Saved crash report: %s @%s %s
handler.crash_save_failed=Failed to persist crash report: %s
handler.key_requested=Telemetry key disclosed to %s on request (plaintext exchange, only on trusted networks)

# ---- packet decoder ----
dec.packet_short=Packet too short: %s bytes
dec.bad_magic=Bad magic, not Xinbot telemetry data
dec.bad_version=Unsupported protocol version: %s
dec.unknown_type=Unknown message type: %s
dec.decrypt_failed=Decryption failed (wrong key or tampered data)
dec.bad_json=Telemetry payload is not valid JSON
dec.type_mismatch=Envelope message type (%s) does not match the JSON payload type (%s)

